{
  "name": "@sigem/platform",
  "private": true,
  "workspaces": [
    "packages/*",
    "services/*",
    "apps/*"
  ],
  "scripts": {
    "build:packages": "npm -w @sigem/shared && npm run build",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "npm run lint --workspaces",
    "format": "prettier --write .",
    "watch": "tsc -b --watch",
    "dev:notif": "npm run dev -w @sigem/notification-service",
    "dev:ref": "npm run dev -w @sigem/reference-service",
    "dev:provider": "npm run dev -w @sigem/provider-service",
    "dev:gateway": "npm run dev -w @sigem/api-gateway",
    "dev:auth": "npm run dev -w @sigem/auth-service",
    "dev:inventory": "npm run dev -w @sigem/inventory-service",
    "dev:log": "npm run dev -w @sigem/log-service",
    "dev:vehicle": "npm run dev -w @sigem/vehicle-service",
    "dev:client": "npm run dev -w @sigem/client",
    "dev": "concurrently -k -n GATEWAY,VEHICLE,NOTIFY,LOG,CLIENT \"npm run dev -w @sigem/api-gateway\" \"npm run dev -w @sigem/vehicle-service\" \"npm run dev -w @sigem/notification-service\" \"npm run dev -w @sigem/client\"",
    "dev:api": "concurrently -k -n GATEWAY,REFERENCE,PROVIDER,VEHICLE,NOTIFY,LOG \"npm run dev -w @sigem/api-gateway\" \"npm run dev -w @sigem/reference-service\" \"npm run dev -w @sigem/provider-service\" \"npm run dev -w @sigem/vehicle-service\"       \"npm run dev -w @sigem/notification-service\"     \"npm run dev -w @sigem/log-service\"",
    "dev:all": "npm run dev",
    "onprem:core:up": "docker compose --env-file infra/compose/onprem/.env.onprem -f infra/compose/onprem/docker-compose.core.yml up -d --build",
    "onprem:core:down": "docker compose --env-file infra/compose/onprem/.env.onprem -f infra/compose/onprem/docker-compose.core.yml down",
    "onprem:vehicle:up": "docker compose --env-file infra/compose/onprem/.env.onprem -f infra/compose/onprem/docker-compose.core.yml -f infra/compose/onprem/docker-compose.vehicle.yml up -d --build vehicle-service",
    "onprem:vehicle:down": "docker compose --env-file infra/compose/onprem/.env.onprem -f infra/compose/onprem/docker-compose.core.yml -f infra/compose/onprem/docker-compose.vehicle.yml stop vehicle-service",
    "onprem:reference:up": "docker compose --env-file infra/compose/onprem/.env.onprem -f infra/compose/onprem/docker-compose.core.yml -f infra/compose/onprem/docker-compose.reference.yml up -d --build reference-service",
    "onprem:reference:down": "docker compose --env-file infra/compose/onprem/.env.onprem -f infra/compose/onprem/docker-compose.core.yml -f infra/compose/onprem/docker-compose.reference.yml stop reference-service",
    "onprem:notification:up": "docker compose --env-file infra/compose/onprem/.env.onprem -f infra/compose/onprem/docker-compose.core.yml -f infra/compose/onprem/docker-compose.notification.yml up -d --build notification-service",
    "onprem:notification:down": "docker compose --env-file infra/compose/onprem/.env.onprem -f infra/compose/onprem/docker-compose.core.yml -f infra/compose/onprem/docker-compose.notification.yml stop notification-service",
    "onprem:log:up": "docker compose --env-file infra/compose/onprem/.env.onprem -f infra/compose/onprem/docker-compose.core.yml -f infra/compose/onprem/docker-compose.log.yml up -d --build log-service",
    "onprem:log:down": "docker compose --env-file infra/compose/onprem/.env.onprem -f infra/compose/onprem/docker-compose.core.yml -f infra/compose/onprem/docker-compose.log.yml stop log-service",
    "onprem:provider:up": "docker compose --env-file infra/compose/onprem/.env.onprem -f infra/compose/onprem/docker-compose.core.yml -f infra/compose/onprem/docker-compose.provider.yml up -d --build provider-service",
    "onprem:provider:down": "docker compose --env-file infra/compose/onprem/.env.onprem -f infra/compose/onprem/docker-compose.core.yml -f infra/compose/onprem/docker-compose.provider.yml stop provider-service",
    "onprem:gateway:up": "docker compose --env-file infra/compose/onprem/.env.onprem -f infra/compose/onprem/docker-compose.core.yml -f infra/compose/onprem/docker-compose.vehicle.yml -f infra/compose/onprem/docker-compose.api-gateway.yml up -d --build api-gateway",
    "onprem:gateway:down": "docker compose --env-file infra/compose/onprem/.env.onprem -f infra/compose/onprem/docker-compose.core.yml -f infra/compose/onprem/docker-compose.vehicle.yml -f infra/compose/onprem/docker-compose.api-gateway.yml stop api-gateway",
    "onprem:client:up": "docker compose --env-file infra/compose/onprem/.env.onprem -f infra/compose/onprem/docker-compose.core.yml -f infra/compose/onprem/docker-compose.vehicle.yml -f infra/compose/onprem/docker-compose.api-gateway.yml -f infra/compose/onprem/docker-compose.client.yml up -d --build client",
    "onprem:client:down": "docker compose --env-file infra/compose/onprem/.env.onprem -f infra/compose/onprem/docker-compose.core.yml -f infra/compose/onprem/docker-compose.vehicle.yml -f infra/compose/onprem/docker-compose.api-gateway.yml -f infra/compose/onprem/docker-compose.client.yml stop client",
    "onprem:pilot:up": "docker compose --env-file infra/compose/onprem/.env.onprem -f infra/compose/onprem/docker-compose.core.yml -f infra/compose/onprem/docker-compose.vehicle.yml -f infra/compose/onprem/docker-compose.api-gateway.yml -f infra/compose/onprem/docker-compose.client.yml up -d --build",
    "onprem:pilot:down": "docker compose --env-file infra/compose/onprem/.env.onprem -f infra/compose/onprem/docker-compose.core.yml -f infra/compose/onprem/docker-compose.vehicle.yml -f infra/compose/onprem/docker-compose.api-gateway.yml -f infra/compose/onprem/docker-compose.client.yml down",
    "onprem:pilot:logs": "docker compose --env-file infra/compose/onprem/.env.onprem -f infra/compose/onprem/docker-compose.core.yml -f infra/compose/onprem/docker-compose.vehicle.yml -f infra/compose/onprem/docker-compose.api-gateway.yml -f infra/compose/onprem/docker-compose.client.yml logs -f"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/nodemailer": "^7.0.4",
    "@types/otp-generator": "^4.0.2",
    "@types/papaparse": "^5.5.2",
    "concurrently": "^9.2.1",
    "eslint": "^9.13.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "prettier": "^3.3.3",
    "rimraf": "^6.0.1",
    "tsup": "^8.5.1",
    "tsx": "^4.19.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@radix-ui/react-tabs": "^1.1.13",
    "axios": "^1.13.2",
    "bcrypt": "^6.0.0",
    "cmdk": "^1.1.1",
    "cookie": "^1.0.2",
    "cors": "^2.8.5",
    "cron": "^4.3.4",
    "dotenv": "^17.4.1",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "http-proxy-middleware": "^3.0.5",
    "jsonwebtoken": "^9.0.2",
    "jspdf": "^4.0.0",
    "jspdf-autotable": "^5.0.7",
    "kafkajs": "^2.2.4",
    "mongoose": "^8.19.2",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "mysql2": "^3.16.0",
    "node-cron": "^4.2.1",
    "nodemailer": "^7.0.11",
    "otp-generator": "^4.0.1",
    "papaparse": "^5.5.3",
    "pino": "^9.4.0",
    "pino-http": "^11.0.0",
    "react": "^19.1.0",
    "recharts": "^3.5.1",
    "reflect-metadata": "^0.2.2",
    "snappy": "^7.3.3",
    "typeorm": "^0.3.28",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8"
  }
}
